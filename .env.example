# =========================
# NexusPlay Environment Vars
# =========================
# Copy this file to ".env" for local development:
#   cp .env.example .env
#
# Never commit ".env" (it contains secrets).

# RAWG API key (leave blank to run in demo mode)
GHUB_API_KEY=

# Frontend URL allowed by CORS (local dev)
APP_URL=http://localhost:5173

# API (Express proxy) tuning
REQUEST_TIMEOUT_MS=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Local dev only (Vercel will set PORT automatically)
PORT=3030

# Node environment
NODE_ENV=development